{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SidneyBissoli/sih-br-mcp",
  "title": "DATASUS SIH/SUS — Brazil Hospital Admissions (AIH) MCP",
  "description": "DATASUS SIH/SUS hospital admissions in Brazil (AIH, 1992-2025): ICD-10 causes, ICSAP, rates.",
  "websiteUrl": "https://sih.sidneybissoli.com",
  "icons": [
    {
      "src": "https://sih.sidneybissoli.com/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/SidneyBissoli/sih-br-mcp",
    "source": "github"
  },
  "version": "1.0.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "sih-br-mcp",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SIH_CACHE_DIR",
          "description": "Folder for the local cache of cubes and population files downloaded from the public channel (default ~/.cache/sih-br-mcp/cubos).",
          "isRequired": false
        },
        {
          "name": "SIH_CUBES_BASE_URL",
          "description": "Alternative channel base URL (default https://data.sidneybissoli.com/sih/cubos/).",
          "isRequired": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://sih.sidneybissoli.com/mcp"
    }
  ]
}
