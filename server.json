{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SidneyBissoli/sih-br-mcp",
  "title": "DATASUS SIH/SUS — Brazil Hospital Admissions (AIH) MCP",
  "description": "DATASUS SIH/SUS hospital admissions in Brazil (AIH, 1992-2025): ICD-10 causes, ICSAP, rates.",
  "websiteUrl": "https://sih.sidneybissoli.com",
  "icons": [
    {
      "src": "https://sih.sidneybissoli.com/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/SidneyBissoli/sih-br-mcp",
    "source": "github"
  },
  "version": "1.5.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "sih-br-mcp",
      "version": "1.5.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SIH_CACHE_DIR",
          "description": "Folder for the local cache of cubes and population files downloaded from the public channel (default ~/.cache/sih-br-mcp/cubos).",
          "isRequired": false
        },
        {
          "name": "SIH_CUBES_BASE_URL",
          "description": "Alternative channel base URL (default https://data.sidneybissoli.com/sih/cubos/).",
          "isRequired": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://sih.sidneybissoli.com/mcp"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "io.github.sidneybissoli/mcp-surface": {
        "form": "mcp-surface/1",
        "spec": "https://github.com/SidneyBissoli/mcp-br-commons/blob/main/packages/mcp-surface/SPEC.md",
        "endpoint": "https://sih.sidneybissoli.com/mcp",
        "declared": {
          "sha256": "265f6bf9b71027bfbc8f8933f98ad0d5147ba705cc1ba14992fb3cb12f009e1a",
          "lockedAt": "1.5.0"
        },
        "anonymous": {
          "sha256": "7c0483c507734556e662d7b01f3c967b5149ef6979a42d9d63feb0b2bce8e922",
          "answers": {
            "initialize": true,
            "ping": true,
            "tools/list": true,
            "resources/list": false,
            "resources/templates/list": false,
            "prompts/list": false,
            "tools/call": true
          },
          "call": {
            "name": "list_cid_chapters",
            "arguments": {}
          }
        }
      }
    }
  }
}
