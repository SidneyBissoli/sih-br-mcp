        },
        "sex": {
          "type": "string",
          "enum": [
            "M",
            "F"
          ],
          "description": "Filtrar por sexo"
        },
        "age_min": {
          "type": "integer",
          "description": "Idade mínima"
        },
        "age_max": {
          "type": "integer",
          "description": "Idade máxima"
        },
        "group_by": {
          "type": "array",
          "items": {
            "type": "string",
