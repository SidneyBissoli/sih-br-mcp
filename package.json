{
  "name": "sih-br-mcp",
  "version": "0.17.0",
  "mcpName": "io.github.SidneyBissoli/sih-br-mcp",
  "description": "Servidor MCP do DATASUS SIH/SUS: internações hospitalares do Brasil (AIH, 1992–2025) — causas CID-10 e CID-9, séries mensais, ICSAP e taxas por UF e município, sem baixar .dbc nem usar TabNet. Brazilian hospital admissions (SIH/SUS) MCP server.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SidneyBissoli/sih-br-mcp.git"
  },
  "homepage": "https://github.com/SidneyBissoli/sih-br-mcp#readme",
  "bugs": {
    "url": "https://github.com/SidneyBissoli/sih-br-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sih-br-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "smoke:stdio": "node scripts/smoke-stdio.mjs --fixtures tests/fixtures/sih --baseline baselines/surface-stdio.json",
    "smoke:stdio:baseline": "node scripts/smoke-stdio.mjs --fixtures tests/fixtures/sih --write baselines/surface-stdio.json",
    "golden:tools": "node scripts/golden-tools.mjs --fixtures tests/fixtures/sih --baseline baselines/golden-tools.json",
    "golden:tools:baseline": "node scripts/golden-tools.mjs --fixtures tests/fixtures/sih --write baselines/golden-tools.json",
    "equiv:summary": "node scripts/summary-equivalence.mjs --fixtures tests/fixtures/sih",
    "equiv:series": "node scripts/series-routing-equivalence.mjs --fixtures tests/fixtures/sih",
    "equiv:causas": "node scripts/causas-routing-equivalence.mjs --fixtures tests/fixtures/sih",
    "cube:isolation": "node scripts/cube-isolation.mjs --fixtures tests/fixtures/sih",
    "freshness": "node scripts/freshness-check.mjs",
    "freshness:selftest": "node scripts/freshness-check.mjs --fixtures tests/fixtures/sih --selftest",
    "freshness:excerpt": "node scripts/freshness-check.mjs --fixtures tests/fixtures/sih --write-excerpt",
    "cache:selftest": "node scripts/cache-selftest.mjs",
    "tables:check": "node scripts/tables-check.mjs",
    "tables:check:offline": "node scripts/tables-check.mjs --manifest tests/fixtures/sih/cubes-manifest-excerpt.json",
    "start:http": "node dist/http.js",
    "smoke:http": "node scripts/smoke-http.mjs --fixtures tests/fixtures/sih --baseline baselines/surface-stdio.json"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "datasus",
    "sih",
    "sih-sus",
    "aih",
    "sus",
    "internacoes-hospitalares",
    "hospital-admissions",
    "brasil",
    "brazil",
    "cid-10",
    "icd-10",
    "icsap",
    "csap",
    "ambulatory-care-sensitive-conditions",
    "saude-publica",
    "epidemiologia"
  ],
  "author": "Sidney Bissoli",
  "license": "MIT",
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@sbissoli/mcp-provenance": "^0.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
